<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="app.cabinet.vue.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Gestion du Cabinet Dentaire">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <Button onAction="#handleChargerDentistes" text="Charger la liste des Dentistes" />

    <ListView fx:id="dentisteListView" prefHeight="180.0" prefWidth="400.0" />

    <VBox spacing="8.0">
        <HBox spacing="10.0">
            <TextField fx:id="nomField" promptText="Nom" HBox.hgrow="ALWAYS" />
            <TextField fx:id="prenomField" promptText="Prénom" HBox.hgrow="ALWAYS" />
        </HBox>
        <HBox spacing="10.0">
            <TextField fx:id="specialiteField" promptText="Spécialité" HBox.hgrow="ALWAYS" />
            <Button onAction="#handleAjouterDentiste" style="-fx-background-color: #2e7d32; -fx-text-fill: white;" text="Ajouter Dentiste" />
        </HBox>
    </VBox>
</VBox>